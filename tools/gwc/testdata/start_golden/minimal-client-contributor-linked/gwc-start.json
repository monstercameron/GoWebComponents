    "htmlPath": "index.html",
    "wasmPath": "main.wasm",
    "devHost": "127.0.0.1",
    "devPort": "8080",
    "defaultBuildProfile": "development",
    "releaseOutDir": "bin/wasm-release",
    "releaseBinaryName": "app.wasm",
    "releaseCompression": "gzip+brotli"
