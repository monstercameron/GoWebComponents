# ── AI Chat Wizard — environment configuration ───────────────────────────────
# Copy this file to .env and fill in your values.
# The server loads .env automatically on start (existing env vars take priority).

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4.1-mini

# Optional: server listen address (default: 127.0.0.1:8095)
LISTEN_ADDR=127.0.0.1:8095

# Optional: premium percent added on top of usage costs for account totals (default: 5)
CHAT_USAGE_PREMIUM_PERCENT=5
