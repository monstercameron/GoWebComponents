{
  "name": "gowebcomponents-tests",
  "version": "1.0.0",
  "description": "Playwright tests for GoWebComponents WASM",
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build-testapp.mjs",
    "build:benchmark": "node ./scripts/build-benchmark.mjs",
    "test": "go test -tags playwrightgo ./playwrightgo -run TestMainSuite -v",
    "bench": "go test -tags playwrightgo ./playwrightgo -run TestBenchmark -v",
    "test:components": "go test -tags playwrightgo ./playwrightgo -run TestComponents -v",
    "test:integration": "go test -tags playwrightgo ./playwrightgo -run TestIntegration -v",
    "test:state": "go test -tags playwrightgo ./playwrightgo -run TestState -v",
    "test:headed": "go test -tags playwrightgo ./playwrightgo -run TestMainSuite -v",
    "test:debug": "go test -tags playwrightgo ./playwrightgo -run TestMainSuite -v",
    "test:ui": "go test -tags playwrightgo ./playwrightgo -run TestMainSuite -v",
    "install:browsers": "go run github.com/playwright-community/playwright-go/cmd/playwright@v0.5700.1 install chromium"
  }
}
