{
  "name": "gowebcomponents-tests",
  "version": "1.0.0",
  "description": "Playwright tests for GoWebComponents WASM",
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build-testapp.mjs",
    "build:benchmark": "node ./scripts/build-benchmark.mjs",
    "pretest": "npm run build",
    "test": "playwright test",
    "bench": "npm run build:benchmark && playwright test -c playwright.performance.config.js",
    "pretest:components": "npm run build",
    "test:components": "playwright test specs/component_contract.spec.js",
    "pretest:integration": "npm run build",
    "test:integration": "playwright test specs/integration_flows.spec.js",
    "pretest:state": "npm run build",
    "test:state": "playwright test specs/state_stress.spec.js",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "http-server": "^14.1.1"
  }
}
